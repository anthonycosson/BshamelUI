# ---------------------------------------------------------------------------
# Ordre de chargement : Core -> Locales -> UI -> Modules.
# Rien ne doit dépendre d'un fichier chargé plus bas dans cette liste au moment
# de son exécution ; les dépendances tardives passent par PLAYER_LOGIN.
# ---------------------------------------------------------------------------

# Core
Core\Init.lua
Core\Util.lua
Core\Locale.lua

# Locales (enUS est la base, les autres écrasent si GetLocale() correspond)
Locales\enUS.lua
Locales\frFR.lua

Core\DB.lua
Core\Module.lua

# Design system
UI\Theme.lua
UI\Widgets\Base.lua
UI\Widgets\Window.lua
UI\Widgets\Text.lua
UI\Widgets\Button.lua
UI\Widgets\SearchBox.lua
UI\Widgets\Toggle.lua
UI\Widgets\Slider.lua
UI\Widgets\ColorSwatch.lua
# La maquette de barre d'infos du client, reprise dans notre page d'options.
# Elle ne dépend que du thème : rangée ici, près des autres pièces de la fabrique.
UI\Widgets\PlatePreview.lua
UI\Widgets\Dropdown.lua
UI\Widgets\ScrollList.lua
UI\Widgets\MinimapButton.lua
UI\Widgets\Tray.lua
UI\Widgets\SecureMenu.lua
UI\Widgets\Countdown.lua
UI\Widgets\ShadeBorder.lua
UI\Widgets\SlotInfo.lua
UI\Widgets\ItemLevelTag.lua
UI\Widgets\Mover.lua
UI\Widgets\ChatTools.lua
# Panneaux posés à même l'écran. `Panel.lua` est leur socle commun : il vient
# donc avant les pièces qui s'appuient dessus.
UI\Widgets\Panel.lua
UI\Widgets\IconTracker.lua
UI\Widgets\MarkerBar.lua
UI\Widgets\ResourceBar.lua
# Les paliers d'une clé ne sont pas un panneau : ils se posent sur le bloc de
# chrono du client. Ce fichier ne dépend donc pas de `Panel.lua`, il est rangé
# ici pour rester à côté des pièces de la même page.
UI\Widgets\KeyThresholds.lua
# La fenêtre de copie assemble une fenêtre et une zone défilante : elle vient
# après les deux.
UI\Widgets\CopyWindow.lua

# Le moteur du mode sombre trace des bords d'icônes : il vient après la fabrique
# de widgets, dont il dépend.
UI\Shade.lua

# Le moteur de déplacement des fenêtres emprunte lui aussi des frames à la
# fabrique : repositionneur sécurisé, capteur de molette, boucle de suivi.
UI\Move.lua

# Le pourtour de la minicarte : le bouton de l'addon et le tiroir qui range ceux
# des autres. Un seul mécanisme, deux réglages — « Général » les porte tous les
# deux, et le moteur reste hors du module comme celui du mode sombre.
UI\MinimapDock.lua

# Fenêtre d'options
UI\Config\PageBuilder.lua
UI\Config\Search.lua
UI\Config\Sidebar.lua
UI\Config\ConfigFrame.lua

# Modules
Modules\General.lua
Modules\DarkMode.lua
Modules\Character.lua
Modules\ActionBars.lua
Modules\UnitFrames.lua
Modules\ClassResource.lua
# Les barres d'infos tiennent en deux fichiers : ce que la page déclare, puis le
# moteur qui agit. La page charge d'abord — le moteur relit ce qu'elle publie, et
# `RegisterModule` réclame la liste des options au moment où il s'exécute.
Modules\NameplatesPage.lua
Modules\Nameplates.lua
Modules\CooldownManager.lua
Modules\Windows.lua
Modules\Chat.lua
Modules\Bags.lua
Modules\AuctionHouse.lua
Modules\Quest.lua
Modules\Keystones.lua
Modules\GroupFinder.lua
Modules\Teleports.lua
Modules\RaidCooldowns.lua
Modules\MythicTimer.lua
Modules\RaidPanel.lua
Modules\CombatLog.lua
Modules\Annoyances.lua
# Seul module de la catégorie « Inutile mais indispensable », et il ferme donc la
# liste comme sa catégorie ferme la barre latérale.
Modules\Emotes.lua

# `Modules/Upcoming.lua` a disparu : un module annoncé n'est plus une déclaration
# sans code, c'est son propre fichier avec `preview = true` en tête. Le core
# refuse alors de l'allumer, et sa page s'affiche grisée. Retirer cette ligne est
# le seul geste qui la livre — plus aucun module n'en porte aujourd'hui.

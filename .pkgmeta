# =========================================================================
#  Packaging BigWigs — Bshamel UI
#  https://github.com/BigWigsMods/packager
#
#  Le dépôt *est* le dossier d'addon : tout ce qui n'est pas du code de jeu doit
#  donc être exclu explicitement du zip, sinon il finit dans l'installation des
#  joueurs.
# =========================================================================

package-as: BshamelUI

enable-nolib-creation: no
enable-toc-creation: no

# Tout ce qui ne part pas chez le joueur.
# `dev` couvre la documentation, les scripts et le packager d'un seul coup :
# c'est tout l'intérêt de les avoir regroupés. Le reste est constitué de
# fichiers de configuration que leurs outils exigent à la racine.
ignore:
  - dev
  - .claude
  - .vscode
  - .editorconfig
  - .gitattributes
  - .gitignore
  - .github
  - .luacheckrc
  - .luarc.json
  - CLAUDE.md
  - README.md
  # Le son d'alerte que le joueur dépose chez lui : jamais dans le zip. Voir
  # `.gitignore`, qui est le premier verrou, et `T.ALERT_SOUND`.
  - media/Sonar.ogg

# Ce que CurseForge affiche sur la page du fichier. Le packager envoie ce
# fichier **en entier** : il ne contient donc que les notes de la version en
# cours, engendrées par `dev/scripts/tag-release.sh` à partir de la section
# fraîchement datée de `CHANGELOG.md`. L'historique complet reste dans
# `CHANGELOG.md`, livré avec l'addon.
manual-changelog:
  filename: CHANGELOG-release.md
  markup-type: markdown
